<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <httpErrors>
      <remove statusCode="502" subStatusCode="-1" />
      <remove statusCode="501" subStatusCode="-1" />
      <remove statusCode="500" subStatusCode="-1" />
      <remove statusCode="412" subStatusCode="-1" />
      <remove statusCode="406" subStatusCode="-1" />
      <remove statusCode="405" subStatusCode="-1" />
      <remove statusCode="404" subStatusCode="-1" />
      <remove statusCode="403" subStatusCode="-1" />
      <remove statusCode="401" subStatusCode="-1" />
      <remove statusCode="400" />
      <error statusCode="400" path="C:\Inetpub\vhosts\vlhsglove.com\error_docs\bad_request.html" />
      <remove statusCode="407" />
      <error statusCode="407" path="C:\Inetpub\vhosts\vlhsglove.com\error_docs\proxy_authentication_required.html" />
      <remove statusCode="414" />
      <error statusCode="414" path="C:\Inetpub\vhosts\vlhsglove.com\error_docs\request-uri_too_long.html" />
      <remove statusCode="415" />
      <error statusCode="415" path="C:\Inetpub\vhosts\vlhsglove.com\error_docs\unsupported_media_type.html" />
      <remove statusCode="503" />
      <error statusCode="503" path="C:\Inetpub\vhosts\vlhsglove.com\error_docs\maintenance.html" />
      <error statusCode="401" prefixLanguageFilePath="" path="C:\Inetpub\vhosts\vlhsglove.com\error_docs\unauthorized.html" />
      <error statusCode="403" prefixLanguageFilePath="" path="C:\Inetpub\vhosts\vlhsglove.com\error_docs\forbidden.html" />
      <error statusCode="404" prefixLanguageFilePath="" path="C:\Inetpub\vhosts\vlhsglove.com\error_docs\not_found.html" />
      <error statusCode="405" prefixLanguageFilePath="" path="C:\Inetpub\vhosts\vlhsglove.com\error_docs\method_not_allowed.html" />
      <error statusCode="406" prefixLanguageFilePath="" path="C:\Inetpub\vhosts\vlhsglove.com\error_docs\not_acceptable.html" />
      <error statusCode="412" prefixLanguageFilePath="" path="C:\Inetpub\vhosts\vlhsglove.com\error_docs\precondition_failed.html" />
      <error statusCode="500" prefixLanguageFilePath="" path="C:\Inetpub\vhosts\vlhsglove.com\error_docs\internal_server_error.html" />
      <error statusCode="501" prefixLanguageFilePath="" path="C:\Inetpub\vhosts\vlhsglove.com\error_docs\not_implemented.html" />
      <error statusCode="502" prefixLanguageFilePath="" path="C:\Inetpub\vhosts\vlhsglove.com\error_docs\bad_gateway.html" />
    </httpErrors>
  </system.webServer>
  <location path="sterile-surgical-gloves-exporters.html">
    <system.webServer>
      <httpRedirect enabled="true" destination="https://www.vlhsglove.com/sterile-surgical-gloves-exporters.php" httpResponseStatus="Permanent" />
    </system.webServer>
  </location>
  <location path="non-sterile-gloves-manufacturer.html">
    <system.webServer>
      <httpRedirect enabled="true" destination="https://www.vlhsglove.com/non-sterile-gloves-manufacturer.php" httpResponseStatus="Permanent" />
    </system.webServer>
  </location>
  <location path="powder-free-surgical-gloves.html">
    <system.webServer>
      <httpRedirect enabled="true" destination="https://www.vlhsglove.com/powder-free-surgical-gloves.php" httpResponseStatus="Permanent" />
    </system.webServer>
  </location>
  <location path="non-sterile-surgical-gloves.html">
    <system.webServer>
      <httpRedirect enabled="true" destination="https://www.vlhsglove.com/non-sterile-surgical-gloves.php" httpResponseStatus="Permanent" />
    </system.webServer>
  </location>
  <location path="latexsurgicalgloves-powdered%20free.html">
    <system.webServer>
      <httpRedirect enabled="true" destination="https://www.vlhsglove.com/latexsurgicalgloves-powderedfree.php" httpResponseStatus="Permanent" />
    </system.webServer>
  </location>
  <system.web>
    <compilation tempDirectory="C:\Inetpub\vhosts\vlhsglove.com\tmp" />
  </system.web>
</configuration>